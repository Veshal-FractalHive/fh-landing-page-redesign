---
import { Icon } from 'astro-icon/components';
import { nav } from '../../config/site';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const link =
	'rounded-md px-2.5 py-1.5 text-small text-muted transition-colors duration-(--duration-fast) hover:text-ink aria-[current=page]:text-ink';
---

<!--
	Sits over the top of the page and scrolls away with it (not sticky), transparent so the hero ribbon
	runs underneath, Stripe-style. Solid only while the mobile menu is open.
-->
<header class="absolute inset-x-0 top-0 z-40 has-[details[open]]:border-b has-[details[open]]:border-line has-[details[open]]:bg-surface">
	<Container class="flex h-16 items-center gap-6">
		<Logo />

		<nav aria-label="Main" class="hidden flex-1 items-center gap-1 md:flex">
			{nav.products.map((item) => (
				<a
					href={item.href}
					class:list={[link, 'font-medium']}
					aria-current={isCurrent(item.href) ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
			<span class="mx-2 h-4 w-px bg-line" aria-hidden="true"></span>
			{nav.company.map((item) => (
				<a href={item.href} class={link} aria-current={isCurrent(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>

		<div class="ml-auto hidden md:block">
			<Button href={nav.cta.href}>{nav.cta.label}</Button>
		</div>

		<!-- Mobile menu: native <details>, works without JavaScript. Products stay first. -->
		<details class="group ml-auto md:hidden">
			<summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg text-ink hover:bg-ink/5 [&::-webkit-details-marker]:hidden">
				<Icon name="lucide:menu" class="size-5 group-open:hidden" aria-hidden="true" />
				<Icon name="lucide:x" class="hidden size-5 group-open:block" aria-hidden="true" />
				<span class="sr-only">Menu</span>
			</summary>
			<nav
				aria-label="Mobile"
				class="absolute inset-x-0 top-16 grid gap-1 border-b border-line bg-surface px-4 pt-2 pb-5"
			>
				{nav.products.map((item) => (
					<a href={item.href} class="rounded-md px-2 py-2.5 font-medium text-ink">
						{item.label}
					</a>
				))}
				<hr class="my-1 border-line" />
				{nav.company.map((item) => (
					<a href={item.href} class="rounded-md px-2 py-2.5 text-muted">
						{item.label}
					</a>
				))}
				<Button href={nav.cta.href} class="mt-3">
					{nav.cta.label}
				</Button>
			</nav>
		</details>
	</Container>
</header>
