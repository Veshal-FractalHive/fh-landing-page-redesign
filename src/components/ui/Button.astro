---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'inverse';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
	href?: string;
	variant?: Variant;
	type?: 'button' | 'submit';
}

const { href, variant = 'primary', type = 'button', class: className, ...rest } = Astro.props;

const variants = {
	primary: 'bg-brand text-on-brand hover:bg-brand/90',
	secondary: 'border border-line bg-panel text-ink hover:border-ink/40',
	ghost: 'text-ink hover:bg-ink/5',
	inverse: 'bg-surface text-navy hover:bg-surface/90', // on navy panels
} satisfies Record<Variant, string>;

const classes = [
	'inline-flex items-center justify-center gap-2 rounded-sm px-4 py-2.5 text-small font-medium',
	'transition-[transform,background-color,border-color] duration-(--duration-press) ease-out active:scale-[0.97]',
	'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
	variants[variant],
	className,
];
---

{href ? (
	<a href={href} class:list={classes} {...rest}>
		<slot />
	</a>
) : (
	<button type={type} class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
		<slot />
	</button>
)}
